---
interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
const iconSize = size === 'sm' ? 'w-6 h-6' : 'w-8 h-8';
const textSize = size === 'sm' ? 'text-lg' : 'text-xl';
---

<a href="/" class="group relative flex items-center justify-center gap-2 transition-all duration-300">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[iconSize, 'text-brand-500 group-hover:rotate-12 transition-transform']}>
    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
  </svg>
  <div class="flex flex-col">
    <span class:list={[textSize, 'font-display font-bold uppercase tracking-tight text-white group-hover:text-brand-400 text-glow-hover transition-colors leading-none']}>
      LOCAL
    </span>
    <span class:list={[textSize, 'font-display font-bold uppercase tracking-tight text-brand-400 transition-colors leading-none']}>
      AUTOGLASS
    </span>
  </div>
</a>
