---
import { testimonials } from '../../data/testimonials';
import StarRating from '../ui/StarRating.astro';
---

<section class="py-24 bg-dark-900 border-y border-white/5 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-500/5 via-transparent to-transparent"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-xs font-semibold tracking-widest text-brand-400 uppercase mb-4 block">Testimonials</span>
      <h2 class="text-4xl md:text-6xl font-bold text-white tracking-tight">
        Local Reviews
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((testimonial, i) => (
        <div class={`reveal delay-${(i + 1) * 100} group relative rounded-2xl bg-white/[0.03] backdrop-blur-md border border-white/10 hover:border-brand-500/30 p-8 transition-all duration-300 hover:-translate-y-1`}>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-full bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 font-bold text-lg">
              {testimonial.name.split(' ').map((n) => n[0]).join('')}
            </div>
            <div>
              <p class="font-semibold text-white">{testimonial.name}</p>
              <p class="text-sm text-zinc-500">{testimonial.location}</p>
            </div>
          </div>
          <StarRating />
          <p class="mt-4 text-zinc-400 italic leading-relaxed">"{testimonial.text}"</p>
          <div class="mt-4 flex items-center gap-1.5">
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            <span class="text-xs text-zinc-500">{testimonial.source}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12 reveal">
      <a
        href="https://www.google.com/maps/search/?api=1&query=Local+Autoglass+Lismore"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-white border border-white/10 hover:border-white/20 rounded-full px-5 py-2.5 transition-all"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        View all 85 reviews on Google
      </a>
    </div>
  </div>
</section>
