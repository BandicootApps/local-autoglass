---
import Logo from '../ui/Logo.astro';
---

<header id="site-header" class="fixed top-0 w-full z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <Logo />

    <nav class="hidden md:flex items-center gap-8 bg-zinc-900/60 backdrop-blur-md border border-white/10 rounded-full px-8 py-3 shadow-lg">
      <a href="/" class="text-sm font-medium text-white hover:text-brand-400 transition-colors">Home</a>
      <a href="/services" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Services</a>
      <a href="/faq" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">FAQ</a>
      <a href="/photos" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Gallery</a>
      <a href="/blog" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Blog</a>
    </nav>

    <a href="tel:0466140195" class="hidden md:flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all group shadow-lg shadow-brand-500/20">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>0466 140 195</span>
    </a>

    <button id="mobile-menu-btn" class="md:hidden text-white hover:text-brand-400 transition-colors" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-dark-950/90', 'backdrop-blur-xl', 'border-b', 'border-white/5');
    } else {
      header?.classList.remove('bg-dark-950/90', 'backdrop-blur-xl', 'border-b', 'border-white/5');
    }
  });
</script>
