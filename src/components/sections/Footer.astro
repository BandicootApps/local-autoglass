---
import Logo from '../ui/Logo.astro';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'FAQ', href: '/faq' },
  { name: 'Gallery', href: '/photos' },
  { name: 'Blog', href: '/blog' },
];

const serviceAreas = [
  { name: 'Lismore', href: '/services/lismore' },
  { name: 'Ballina', href: '/services/ballina' },
  { name: 'Byron Bay', href: '/services/byron-bay' },
  { name: 'Alstonville', href: '/services/alstonville' },
  { name: 'Mullumbimby', href: '/services/mullumbimby' },
  { name: 'Bangalow', href: '/services/bangalow' },
  { name: 'Lennox Head', href: '/services/lennox-head' },
  { name: 'Bentley', href: '/services/bentley' },
  { name: 'Evans Head', href: '/services/evans-head' },
];
---

<footer class="bg-dark-950 border-t border-white/5 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <Logo size="sm" />
        <p class="mt-4 text-sm text-zinc-400 leading-relaxed">
          Professional mobile windscreen replacement servicing the Northern Rivers and surrounding areas. Family owned and operated for over 35 years.
        </p>
        <div class="flex gap-4 mt-6">
          <!-- Facebook -->
          <a href="https://www.facebook.com/profile.php?id=61584732189662" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 hover:border-brand-500/30 flex items-center justify-center text-zinc-400 hover:text-brand-400 transition-all" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/local_autoglass/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 hover:border-brand-500/30 flex items-center justify-center text-zinc-400 hover:text-brand-400 transition-all" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-zinc-400 hover:text-brand-400 transition-colors">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Service Areas</h3>
        <ul class="space-y-3">
          {serviceAreas.map((area) => (
            <li>
              <a href={area.href} class="text-sm text-zinc-400 hover:text-brand-400 transition-colors">{area.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Contact</h3>
        <ul class="space-y-3">
          <li>
            <a href="tel:0466140195" class="text-sm text-zinc-400 hover:text-brand-400 transition-colors flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              0466 140 195
            </a>
          </li>
          <li>
            <a href="mailto:info@localautoglass.com.au" class="text-sm text-zinc-400 hover:text-brand-400 transition-colors flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              info@localautoglass.com.au
            </a>
          </li>
          <li class="text-sm text-zinc-400 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            Northern Rivers, NSW
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-zinc-500">
        &copy; {currentYear} Local Auto Glass. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-brand-400"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          Licensed MVRL63433
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-brand-400"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          Fully Insured
        </span>
      </div>
    </div>
  </div>
</footer>
