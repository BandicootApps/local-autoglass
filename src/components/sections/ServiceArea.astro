---
import { locations } from '../../data/locations';
---

<section class="py-24 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-dark-950 via-dark-900/50 to-dark-950"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="text-xs font-semibold tracking-widest text-brand-400 uppercase mb-4 block">Where We Service</span>
      <h2 class="text-4xl md:text-6xl font-bold text-white tracking-tight">
        Service Area
      </h2>
      <p class="mt-4 text-zinc-400 max-w-2xl mx-auto">We provide mobile windscreen replacement across the Northern Rivers region and surrounding areas. If you're not sure whether we cover your area, give us a call.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 auto-rows-fr gap-4 mb-12">
      {locations.map((location, i) => (
        <a
          href={`/services/${location.slug}`}
          class={`reveal delay-${(i % 3 + 1) * 100} group h-full p-5 rounded-xl bg-white/[0.03] border border-white/10 hover:border-brand-500/30 transition-all duration-300`}
        >
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-brand-500/10 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-500">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-lg font-semibold text-white group-hover:text-brand-400 transition-colors">{location.name}</h3>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-zinc-600 group-hover:text-brand-500 group-hover:translate-x-1 transition-all shrink-0">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
              <p class="text-sm text-zinc-400 mt-1">{location.tagline}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Google Maps -->
    <div class="reveal rounded-2xl overflow-hidden border border-white/10">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1786943.7364390101!2d151.5840784526549!3d-28.983681966779866!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa97129832f95c21b%3A0x1814e6a1752e7e2a!2sLocal%20Autoglass%20Lismore!5e0!3m2!1sen!2sau!4v1774927477880!5m2!1sen!2sau"
        width="100%"
        height="400"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Local Auto Glass — 274 Magellan St, Lismore NSW"
        class="w-full"
      ></iframe>
    </div>
  </div>
</section>
