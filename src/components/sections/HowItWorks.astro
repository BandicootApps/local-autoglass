      <h2 class="text-4xl md:text-6xl font-bold text-white tracking-tight">
        Back on the Road in 3 Easy Steps
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-12 relative">
      <!-- Connecting line -->
      <div class="hidden md:block absolute top-12 left-[20%] right-[20%] h-0.5 bg-gradient-to-r from-brand-500/50 via-brand-500/20 to-brand-500/50"></div>

      <!-- Step 1 -->
      <div class="reveal delay-100 text-center relative">
        <div class="relative mx-auto w-24 h-24 rounded-full bg-white/[0.03] border border-white/10 flex items-center justify-center mb-6 group">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-brand-400">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
