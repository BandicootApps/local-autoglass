---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import MobileMenu from '../components/sections/MobileMenu.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ServicesTicker from '../components/sections/ServicesTicker.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import StatsBar from '../components/sections/StatsBar.astro';
import Gallery from '../components/sections/Gallery.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ServiceArea from '../components/sections/ServiceArea.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Footer from '../components/sections/Footer.astro';

const title = 'Mobile Windscreen Replacement Northern Rivers | Local Auto Glass';
const description = 'Mobile windscreen replacement for cars, trucks, tractors, and machinery across the Northern Rivers. Call Nigel on 0466 140 195 for a free quote.';

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Get Your Windscreen Replaced with Local Auto Glass',
  description: 'Get your windscreen replaced in 3 easy steps — call for a quote, we come to you, and you are back on the road.',
  totalTime: 'PT1H',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Give Nigel a Call',
      text: 'Ring us on 0466 140 195 or send a text. Tell us your vehicle make, model, and what glass you need replaced.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Get a Free Quote',
      text: 'We confirm the details, check stock availability, and give you an upfront price — no hidden fees, no surprises.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'We Come to You',
      text: 'We arrive at your home, workplace, or wherever suits — fully equipped and ready to go. Most jobs done in under an hour.',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://localautoglass.com.au"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </Fragment>

  <Header />
  <MobileMenu />
  <main>
    <HeroSection />
    <ServicesTicker />
    <WhyChooseUs />
    <HowItWorks />
    <ServicesGrid />
    <StatsBar />
    <Gallery />
    <FAQSection />
    <Testimonials />
    <ServiceArea />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
