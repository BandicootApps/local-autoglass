---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
---

<BaseLayout title="Page Not Found — Local Auto Glass" description="The page you're looking for doesn't exist.">
  <Header />
  <main>
    <section class="flex min-h-screen items-center justify-center py-24 px-8">
      <div class="text-center">
        <h1 class="font-display text-7xl font-extrabold text-white">404</h1>
        <p class="mt-4 text-lg text-zinc-400">
          The page you're looking for doesn't exist.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex rounded-full bg-brand-500 hover:bg-brand-600 px-8 py-3 font-sans text-[15px] font-semibold text-white transition"
        >
          Go Home
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
