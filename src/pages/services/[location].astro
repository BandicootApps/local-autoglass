---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import MobileMenu from '../../components/sections/MobileMenu.astro';
import Footer from '../../components/sections/Footer.astro';
import { Image } from 'astro:assets';
import { locations, getLocationBySlug } from '../../data/locations';
import type { Location } from '../../data/locations';

import carUteImg from '../../assets/local-autoglass-car-ute-windscreen-replacement.jpg';
import truckImg from '../../assets/local-autoglass-truck-heavy-machinery-windscreen-replacement.jpg';
import adasImg from '../../assets/local-autoglass-adas-calibration-after-windscreen-replacement.jpg';

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;

const nearbyLocations = location.nearbyLocations
  .map((slug) => getLocationBySlug(slug))
  .filter((loc): loc is Location => loc !== undefined);

const title = `Windscreen Replacement ${location.name} | Local Auto Glass`;
const description = `Mobile windscreen replacement in ${location.name}, ${location.region}. Professional on-site service for cars, trucks, and machinery. Call 0466 140 195 for a free quote.`;

const locationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Windscreen Replacement',
  name: `Mobile Windscreen Replacement in ${location.name}`,
  description: `Professional mobile windscreen replacement service in ${location.name}, ${location.region}. We come to your home or workplace.`,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://localautoglass.com.au/#organization',
    name: 'Local Auto Glass',
    telephone: '+61466140195',
    email: 'local.autoglass.nr@gmail.com',
  },
  areaServed: {
    '@type': 'City',
    name: location.name,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: location.latitude,
      longitude: location.longitude,
    },
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: 'Northern Rivers, NSW',
    },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Windscreen Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Car & Ute Windscreen Replacement',
          description: `Mobile windscreen replacement for all makes and models in ${location.name}.`,
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Truck & Heavy Machinery Windscreen Replacement',
          description: `On-site windscreen replacement for trucks and heavy machinery in ${location.name}.`,
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'ADAS Calibration',
          description: `Professional ADAS recalibration after windscreen replacement in ${location.name}.`,
        },
      },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: location.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const mapIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
const phoneIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`;
const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
const chevronIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-zinc-400 flex-shrink-0 transition-transform duration-300 faq-chevron"><path d="m6 9 6 6 6-6"/></svg>`;
const shieldIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-brand-500"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`;
const wrenchIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-brand-500"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`;
const clockIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-brand-500"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
const usersIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-500"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
const clockLgIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-500"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
const mapLgIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-500"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
const mapSmIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-brand-500 flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`https://localautoglass.com.au/services/${location.slug}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(locationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />
  <MobileMenu />

  <main>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 bg-dark-950 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-brand-500/5 to-transparent pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="reveal">
          <div class="flex items-center gap-2 text-brand-500 mb-4">
            <Fragment set:html={mapIcon} />
            <span class="text-sm font-medium uppercase tracking-wide">{location.region}</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-white tracking-tight mb-6">
            Mobile Windscreen Replacement in {location.name}
          </h1>
          <p class="text-xl text-zinc-400 font-light max-w-3xl mb-8">
            {location.description}
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="tel:0466140195"
              class="inline-flex items-center gap-3 bg-brand-500 hover:bg-brand-600 text-white px-8 py-4 rounded-lg text-lg font-semibold transition-all shadow-lg shadow-brand-500/20 transform hover:-translate-y-1"
            >
              <Fragment set:html={phoneIcon} />
              <span>Call 0466 140 195</span>
            </a>
            <a
              href="/services"
              class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-white px-8 py-4 rounded-lg text-lg font-medium transition-all"
            >
              View All Services
              <Fragment set:html={arrowIcon} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Location Stats Bar -->
    <section class="py-12 bg-dark-900 border-y border-white/5">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">
          <div class="flex items-center gap-4 p-6 rounded-xl glass-card">
            <div class="w-12 h-12 rounded-full bg-brand-500/10 flex items-center justify-center shrink-0">
              <Fragment set:html={mapLgIcon} />
            </div>
            <div>
              <p class="text-xs text-zinc-400 uppercase tracking-widest mb-0.5">Distance</p>
              <p class="text-lg text-white font-medium">{location.distanceFromBase}</p>
            </div>
          </div>
          <div class="flex items-center gap-4 p-6 rounded-xl glass-card">
            <div class="w-12 h-12 rounded-full bg-brand-500/10 flex items-center justify-center shrink-0">
              <Fragment set:html={usersIcon} />
            </div>
            <div>
              <p class="text-xs text-zinc-400 uppercase tracking-widest mb-0.5">Population</p>
              <p class="text-lg text-white font-medium">{location.population}</p>
            </div>
          </div>
          <div class="flex items-center gap-4 p-6 rounded-xl glass-card">
            <div class="w-12 h-12 rounded-full bg-brand-500/10 flex items-center justify-center shrink-0">
              <Fragment set:html={clockLgIcon} />
            </div>
            <div>
              <p class="text-xs text-zinc-400 uppercase tracking-widest mb-0.5">Service</p>
              <p class="text-lg text-white font-medium">Same Day Available</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-dark-950">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center reveal">
          <div>
            <h2 class="text-3xl lg:text-4xl font-semibold text-white tracking-tight mb-6">
              Why Choose Us in {location.name}?
            </h2>
            <p class="text-zinc-400 font-light leading-relaxed text-lg mb-8">
              {location.whyChooseUs}
            </p>
            <div class="flex flex-wrap gap-3">
              <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
                <Fragment set:html={shieldIcon} />
                <span class="text-sm text-zinc-300">35+ Years Experience</span>
              </div>
              <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
                <Fragment set:html={wrenchIcon} />
                <span class="text-sm text-zinc-300">100% Mobile Service</span>
              </div>
              <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2">
                <Fragment set:html={clockIcon} />
                <span class="text-sm text-zinc-300">15 Min Install</span>
              </div>
            </div>
          </div>

          <!-- Areas We Cover -->
          <div class="p-8 rounded-2xl glass-card">
            <h3 class="text-xl font-semibold text-white mb-2">
              Areas We Cover in {location.name}
            </h3>
            <p class="text-sm text-zinc-400 mb-6">
              We come to you in all of these suburbs and surrounding areas
            </p>
            <div class="grid grid-cols-2 gap-3">
              {location.suburbs.map((suburb) => (
                <div class="flex items-center gap-2">
                  <Fragment set:html={mapSmIcon} />
                  <span class="text-zinc-300 text-sm">{suburb}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-24 bg-dark-900 border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-16 reveal">
          <h2 class="text-3xl lg:text-4xl font-semibold text-white tracking-tight mb-4">
            Our Services in {location.name}
          </h2>
          <p class="text-lg text-zinc-400 font-light">
            Professional mobile windscreen replacement — we come to you anywhere in {location.name}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Cars & Utes -->
          <div class="group rounded-2xl overflow-hidden glass-card transition-all duration-500 hover:border-brand-500/30 reveal">
            <div class="aspect-[16/10] relative overflow-hidden">
              <Image
                src={carUteImg}
                alt={`Car windscreen replacement in ${location.name}`}
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900 to-transparent opacity-60"></div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-semibold text-white mb-3">Cars &amp; Utes</h3>
              <p class="text-zinc-400 font-light leading-relaxed text-sm">
                {location.services.carsUtes}
              </p>
            </div>
          </div>

          <!-- Trucks & Heavy Machinery -->
          <div class="group rounded-2xl overflow-hidden glass-card transition-all duration-500 hover:border-brand-500/30 reveal delay-100">
            <div class="aspect-[16/10] relative overflow-hidden">
              <Image
                src={truckImg}
                alt={`Truck windscreen replacement in ${location.name}`}
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900 to-transparent opacity-60"></div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-semibold text-white mb-3">Trucks &amp; Heavy Machinery</h3>
              <p class="text-zinc-400 font-light leading-relaxed text-sm">
                {location.services.trucksHeavy}
              </p>
            </div>
          </div>

          <!-- ADAS Calibration -->
          <div class="group rounded-2xl overflow-hidden glass-card transition-all duration-500 hover:border-brand-500/30 reveal delay-200">
            <div class="aspect-[16/10] relative overflow-hidden">
              <Image
                src={adasImg}
                alt={`ADAS calibration service in ${location.name}`}
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 33vw"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900 to-transparent opacity-60"></div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-semibold text-white mb-3">ADAS Calibration</h3>
              <p class="text-zinc-400 font-light leading-relaxed text-sm">
                {location.services.adas}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    {location.faqs.length > 0 && (
      <section class="py-24 bg-dark-950">
        <div class="max-w-3xl mx-auto px-6">
          <div class="text-center mb-12 reveal">
            <h2 class="text-3xl lg:text-4xl font-semibold text-white tracking-tight mb-4">
              {location.name} Windscreen Replacement FAQ
            </h2>
            <p class="text-zinc-400 font-light">
              Common questions about our mobile windscreen service in {location.name}
            </p>
          </div>
          <div class="space-y-3 reveal delay-100">
            {location.faqs.map((faq, index) => (
              <div class="faq-item border border-white/5 rounded-xl overflow-hidden">
                <button
                  class="faq-trigger w-full flex items-center justify-between p-6 text-left hover:bg-white/[0.02] transition-colors"
                  aria-expanded="false"
                >
                  <span class="text-base font-medium text-white pr-4">{faq.question}</span>
                  <Fragment set:html={chevronIcon} />
                </button>
                <div class="faq-panel max-h-0 overflow-hidden transition-all duration-300">
                  <p class="px-6 pb-6 text-zinc-400 font-light leading-relaxed text-sm">{faq.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Nearby Locations -->
    {nearbyLocations.length > 0 && (
      <section class="py-20 bg-dark-900 border-t border-white/5">
        <div class="max-w-7xl mx-auto px-6">
          <div class="mb-12 reveal">
            <h2 class="text-2xl lg:text-3xl font-semibold text-white tracking-tight mb-3">
              Also Servicing Nearby Areas
            </h2>
            <p class="text-zinc-400 font-light">
              We provide mobile windscreen replacement across the entire Northern Rivers region
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal delay-100">
            {nearbyLocations.map((loc) => (
              <a
                href={`/services/${loc.slug}`}
                class="group p-6 rounded-xl glass-card hover:border-brand-500/30 transition-all duration-300"
              >
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-xl font-semibold text-white group-hover:text-brand-400 transition-colors">
                      {loc.name}
                    </h3>
                    <p class="text-sm text-zinc-400 mt-1">{loc.distanceFromBase}</p>
                  </div>
                  <span class="text-zinc-600 group-hover:text-brand-500 group-hover:translate-x-1 transition-all">
                    <Fragment set:html={arrowIcon} />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA Section -->
    <section class="relative py-32 overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/Background-Image.webp"
          alt={`Windscreen replacement service in ${location.name}`}
          class="object-cover w-full h-full opacity-30 grayscale"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-dark-950/80"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center px-6 reveal">
        <h2 class="text-4xl md:text-5xl font-semibold text-white tracking-tight mb-6">
          Book Your {location.name} Windscreen Replacement
        </h2>
        <p class="text-xl text-zinc-400 mb-10 max-w-2xl mx-auto font-light">
          Call Nigel Swift today on <span class="text-white font-medium">0466 140 195</span> for a free quote. We come to you anywhere in {location.name}.
        </p>
        <a
          href="tel:0466140195"
          class="inline-flex items-center gap-3 bg-brand-500 hover:bg-brand-600 text-white px-10 py-5 rounded-lg text-lg font-bold transition-all shadow-xl shadow-brand-500/20 transform hover:-translate-y-1"
        >
          <Fragment set:html={phoneIcon} />
          <span>Call Now — 0466 140 195</span>
        </a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const panel = item?.querySelector('.faq-panel') as HTMLElement | null;
      const chevron = trigger.querySelector('.faq-chevron') as HTMLElement | null;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all
      document.querySelectorAll('.faq-item').forEach((i) => {
        const p = i.querySelector('.faq-panel') as HTMLElement | null;
        const c = i.querySelector('.faq-chevron') as HTMLElement | null;
        const t = i.querySelector('.faq-trigger');
        if (p) p.style.maxHeight = '0';
        if (c) c.style.transform = '';
        if (t) t.setAttribute('aria-expanded', 'false');
      });

      // Open clicked if it was closed
      if (!isOpen && panel && chevron) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
        chevron.style.transform = 'rotate(180deg)';
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
