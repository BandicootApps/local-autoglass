---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import MobileMenu from '../components/sections/MobileMenu.astro';
import Footer from '../components/sections/Footer.astro';
import { faqs } from '../data/faqs';

// Display groups — each has a label and the categories it draws from
const displayGroups = [
  { label: 'Pricing & Quotes',      categories: ['Pricing'] },
  { label: 'Booking & Service',     categories: ['Service', 'Weather'] },
  { label: 'Timing',                categories: ['Speed of Service'] },
  { label: 'ADAS Calibration',      categories: ['ADAS'] },
  { label: 'Insurance & Warranty',  categories: ['Insurance', 'Warranty'] },
  { label: 'Safety & Legal',        categories: ['Safety', 'Legal', 'Small Repairs'] },
  { label: 'Our Credentials',       categories: ['Qualifications'] },
];

const grouped = displayGroups.map(({ label, categories }) => ({
  label,
  items: faqs.filter((f) => categories.includes(f.category)),
})).filter(({ items }) => items.length > 0);

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQ — Windscreen Replacement | Local Auto Glass"
  description="Answers to common questions about mobile windscreen replacement, pricing, ADAS calibration, insurance, and booking. Serving the Northern Rivers region."
  canonicalUrl="https://localautoglass.com.au/faq"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  </Fragment>

  <Header />
  <MobileMenu />

  <main>
    <!-- Hero -->
    <section class="pt-32 pb-16 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-dark-950 via-dark-900/60 to-dark-950"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(158,14,6,0.12),transparent_60%)]"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <span class="text-xs font-semibold tracking-widest text-brand-400 uppercase mb-4 block reveal">Support</span>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight mb-6 reveal">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-zinc-400 max-w-2xl mx-auto reveal delay-100">
          Everything you need to know about mobile windscreen replacement in the Northern Rivers. Can't find your answer?
          <a href="tel:+61466140195" class="text-brand-400 hover:text-brand-300 transition-colors">Call Nigel on 0466 140 195</a>.
        </p>
      </div>
    </section>

    <!-- FAQ Content -->
    <section class="pb-24 relative">
      <div class="max-w-3xl mx-auto px-6 space-y-16">
        {grouped.map(({ label, items }) => (
          <div class="reveal">
            <h2 class="text-xs font-semibold tracking-widest text-brand-400 uppercase mb-6 flex items-center gap-3">
              <span>{label}</span>
              <span class="flex-1 h-px bg-white/10"></span>
            </h2>
            <div class="space-y-3">
              {items.map((faq) => (
                <div class="faq-item rounded-2xl bg-white/[0.03] border border-white/10 overflow-hidden transition-all duration-300">
                  <button
                    class="faq-toggle w-full flex items-center justify-between p-5 text-left group"
                    aria-expanded="false"
                  >
                    <span class="text-base font-semibold text-white pr-4 group-hover:text-brand-400 transition-colors">
                      {faq.question}
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-zinc-400 shrink-0 transition-transform duration-300 faq-icon">
                      <path d="M12 5v14"/><path d="M5 12h14"/>
                    </svg>
                  </button>
                  <div class="faq-content max-h-0 overflow-hidden transition-all duration-300">
                    <div class="px-5 pb-5 text-zinc-400 leading-relaxed whitespace-pre-line">
                      {faq.answer}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-brand-600/20 via-brand-500/10 to-brand-600/20"></div>
      <div class="relative z-10 max-w-3xl mx-auto px-6 text-center reveal">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Still have questions?</h2>
        <p class="text-zinc-400 mb-8">Call or text Nigel directly for a free quote and fast answers.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:+61466140195"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-brand-500 hover:bg-brand-400 text-white font-semibold rounded-full transition-all duration-300 hover:shadow-lg hover:shadow-brand-500/30"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Call 0466 140 195
          </a>
          <a
            href="sms:+61466140195"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-full border border-white/20 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Send a Text
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const content = item?.querySelector('.faq-content') as HTMLElement;
      const icon = item?.querySelector('.faq-icon') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all other items
      document.querySelectorAll('.faq-item').forEach((otherItem) => {
        if (otherItem !== item) {
          const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon') as HTMLElement;
          const otherBtn = otherItem.querySelector('.faq-toggle');
          if (otherContent) otherContent.style.maxHeight = '0';
          if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
          otherBtn?.setAttribute('aria-expanded', 'false');
          otherItem.classList.remove('border-brand-500/30');
          otherItem.classList.add('border-white/10');
        }
      });

      // Toggle current item
      if (isOpen) {
        content.style.maxHeight = '0';
        icon.style.transform = 'rotate(0deg)';
        btn.setAttribute('aria-expanded', 'false');
        item?.classList.remove('border-brand-500/30');
        item?.classList.add('border-white/10');
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.style.transform = 'rotate(45deg)';
        btn.setAttribute('aria-expanded', 'true');
        item?.classList.add('border-brand-500/30');
        item?.classList.remove('border-white/10');
      }
    });
  });
</script>
